#!/usr/bin/python3
"""oet-fleet-ctl: the restricted control surface of an OET fleet helper (OET-RWP/1 section 7.4).

Runs as root through `sudo -n` from oet-fleet-gate. It validates its own arguments again (defence in
depth: the gate and this script share one verb table), never uses a shell, and can only:

  * read host/agent status, run the host baseline check;
  * log in to GHCR with a token read from STDIN into a temporary tmpfs docker config, pull the agent image BY
    DIGEST, verify it, and log out again;
  * write the allow-listed agent environment file, write the UBAG node certificate material (trust plane,
    decision D3), (re)create the single agent container with FIXED hardened flags (`restart` RECREATES it from
    the current env file, because Docker bakes --env-file in at creation), stop it, show its logs, prune old
    agent images, write the boot unit;
  * uninstall: remove ONLY what this fleet installed (the agent container, images of the agent repository,
    /etc/oet-fleet, the boot unit) and lock the oetfleet account. Docker itself, the firewall table, other
    containers, other images and every volume are never touched.

Output: one JSON object on stdout (logs print plain text). Exit 0 = ok, 1 = the operation failed, 2 = refused.
No job content or secret is ever printed.
"""
import json
import base64
import ipaddress
import os
import platform
import re
import shutil
import subprocess
import sys

AGENT_REPO = "ghcr.io/jerryboganda/oetwebapp-fleet-agent"
CONTAINER = "oet-fleet-agent"
CONFIG_DIR = "/etc/oet-fleet"
ENV_FILE = "/etc/oet-fleet/agent.env"
CERT_DIR = "/etc/oet-fleet/ubag"
CERT_FILES = {"ca": "ca.crt", "cert": "node.crt", "key": "node.key"}
# The agent runs as uid 10001 inside the container, so the mounted certificate files must be readable by
# that numeric id on the host too (the same lesson as the tmpfs ownership in start_agent).
AGENT_UID = 10001
DOCKER_CONFIG_DIR = "/run/oet-fleet/dockercfg"
UNIT_PATH = "/etc/systemd/system/oet-fleet-agent.service"
SUDOERS_PATH = "/etc/sudoers.d/oet-fleet"
DOCKER = "/usr/bin/docker"
SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

VERBS = {
    "status": r"",
    "harden-check": r"",
    "login": r"--registry ghcr\.io",
    "pull": r"ghcr\.io/jerryboganda/oetwebapp-fleet-agent@sha256:[0-9a-f]{64}",
    "verify": r"sha256:[0-9a-f]{64}( sha256:[0-9a-f]{64})?",
    "logout": r"",
    "put-env": r"",
    "put-certs": r"",
    "ubag-reconcile": r"",
    "run": r"sha256:[0-9a-f]{64}",
    "stop": r"(--grace ([1-9]|[1-9][0-9]|1[01][0-9]|120))?",
    "restart": r"",
    "logs": r"--tail ([1-9]|[1-9][0-9]|1[0-9][0-9]|200)",
    "prune": r"",
    "wipe-scratch": r"",
    "unit-sync": r"",
    "uninstall": r"",
}

ENV_KEYS = (
    "OET_API_BASE",
    "OET_NODE_ID",
    "OET_NODE_TOKEN",
    "OET_AGENT_IMAGE_DIGEST",
    "OET_BUDGET_CPU_MILLI",
    "OET_BUDGET_MEM_MIB",
    "OET_BUDGET_TMP_MIB",
    "OET_LOG_LEVEL",
    "OET_TRUST_ENABLED",
    "OET_TRUST_PORT",
    "OET_TRUST_CERT_PATH",
    "OET_TRUST_KEY_PATH",
    "OET_TRUST_CA_PATH",
)
ENV_VALUE = re.compile(r"[A-Za-z0-9._:/@+=-]{1,200}")
DIGEST = re.compile(r"sha256:[0-9a-f]{64}")
PEM_CERT = re.compile(r"-----BEGIN CERTIFICATE-----[A-Za-z0-9+/=\s-]+-----END CERTIFICATE-----")
PEM_KEY = re.compile(r"-----BEGIN (?:EC |RSA )?PRIVATE KEY-----[A-Za-z0-9+/=\s-]+-----END (?:EC |RSA )?PRIVATE KEY-----")


class Refused(Exception):
    pass


class Failed(Exception):
    pass


def emit(payload, code=0):
    sys.stdout.write(json.dumps(payload) + "\n")
    sys.stdout.flush()
    sys.exit(code)


def run(command, stdin_text=None, check=True, timeout=600):
    """Runs a program with an argument LIST and a fixed PATH. Returns (returncode, stdout, stderr).

    A program that does not exist (a clean helper has no docker yet, S3 checks the login BEFORE S4 installs it) or cannot
    be executed is reported the way a shell would, as 127 / 126, instead of raising: `check=False` callers then see an
    ordinary failure and `check=True` callers get Failed.
    """
    env = {"PATH": SAFE_PATH, "LC_ALL": "C.UTF-8"}
    try:
        completed = subprocess.run(
            command,
            input=stdin_text,
            capture_output=True,
            text=True,
            env=env,
            timeout=timeout,
            check=False,
        )
    except OSError as error:
        missing = isinstance(error, FileNotFoundError)
        message = os.path.basename(command[0]) + (": not found" if missing else ": cannot be executed")
        if check:
            raise Failed(message)
        return (127 if missing else 126), "", message
    if check and completed.returncode != 0:
        raise Failed((completed.stderr or completed.stdout or "command failed").strip()[:300])
    return completed.returncode, completed.stdout, completed.stderr


def docker(*args, **kwargs):
    return run([DOCKER] + list(args), **kwargs)


def read_stdin(limit):
    data = sys.stdin.read(limit + 1)
    if len(data) > limit:
        raise Refused("stdin is too large")
    return data


def meminfo(key):
    try:
        with open("/proc/meminfo", "r", encoding="ascii") as handle:
            for line in handle:
                if line.startswith(key + ":"):
                    return int(re.sub(r"[^0-9]", "", line))
    except (OSError, ValueError):
        pass
    return 0


def uptime_seconds():
    try:
        with open("/proc/uptime", "r", encoding="ascii") as handle:
            return int(float(handle.read().split()[0]))
    except (OSError, ValueError, IndexError):
        return 0


def os_pretty():
    try:
        with open("/etc/os-release", "r", encoding="utf-8") as handle:
            for line in handle:
                if line.startswith("PRETTY_NAME="):
                    return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "unknown"


def inspect_agent():
    code, out, _ = docker("inspect", CONTAINER, check=False)
    if code != 0:
        return {"present": False}
    try:
        info = json.loads(out)[0]
    except (ValueError, IndexError):
        return {"present": False}
    state = info.get("State", {})
    reference = info.get("Config", {}).get("Image", "")
    digest = reference.split("@", 1)[1] if "@" in reference else None
    return {
        "present": True,
        "state": state.get("Status"),
        "imageDigest": digest,
        "startedAt": state.get("StartedAt"),
        "restartCount": info.get("RestartCount", 0),
        "oomKilled": bool(state.get("OOMKilled", False)),
    }


def collect_status():
    """The status document. It must work on a helper that has no Docker yet: S3 proves the restricted login with `status`
    BEFORE S4 installs Docker, so a missing docker binary is the answer docker.running=false, never an error."""
    docker_version = None
    docker_running = False
    code, out, _ = docker("version", "--format", "{{.Server.Version}}", check=False)
    if code == 0:
        docker_version = out.strip()
        docker_running = True
    sync_ok = False
    code, out, _ = run(["/usr/bin/timedatectl", "show", "-p", "NTPSynchronized", "--value"], check=False)
    if code == 0:
        sync_ok = out.strip() == "yes"
    usage = shutil.disk_usage("/")
    return {
        "schema": "oet-fleet-ctl.status/1",
        "host": {
            "os": os_pretty(),
            "arch": platform.machine() or "unknown",
            "cpuCores": os.cpu_count(),
            "memTotalMiB": meminfo("MemTotal") // 1024,
            "memAvailableMiB": meminfo("MemAvailable") // 1024,
            "diskFreeGiB": usage.free // (1024 ** 3),
            "uptimeSeconds": uptime_seconds(),
            "swapMiB": meminfo("SwapTotal") // 1024,
            "timeSyncOk": sync_ok,
        },
        "docker": {"version": docker_version, "running": docker_running},
        "agent": inspect_agent() if docker_running else {"present": False},
        "ctl": {"version": 1},
    }


def verb_status(args):
    emit(collect_status())


def verb_harden_check(args):
    findings = []
    if meminfo("SwapTotal") != 0:
        findings.append("swap is on")
    try:
        with open("/proc/sys/kernel/core_pattern", "r", encoding="ascii") as handle:
            if not handle.read().strip().startswith("|/bin/false"):
                findings.append("core dumps are enabled")
        with open("/proc/sys/fs/suid_dumpable", "r", encoding="ascii") as handle:
            if handle.read().strip() != "0":
                findings.append("suid core dumps are enabled")
    except OSError:
        findings.append("core dump settings unreadable")
    if run(["/usr/sbin/nft", "list", "table", "inet", "oet_fleet"], check=False)[0] != 0:
        findings.append("firewall table is missing")
    if not os.path.exists("/etc/systemd/journald.conf.d/90-oet-fleet.conf"):
        findings.append("journald is not volatile")
    code, out, _ = run(["/usr/bin/timedatectl", "show", "-p", "NTPSynchronized", "--value"], check=False)
    if code != 0 or out.strip() != "yes":
        findings.append("time is not synchronised")
    code, out, _ = docker("info", "--format", "{{.LoggingDriver}}", check=False)
    if code != 0 or out.strip() != "local":
        findings.append("docker log driver is not local")
    emit({"ok": not findings, "findings": findings}, 0 if not findings else 1)


def verb_login(args):
    lines = read_stdin(512).split("\n")
    user = lines[0].strip() if len(lines) > 0 else ""
    token = lines[1].strip() if len(lines) > 1 else ""
    if re.fullmatch(r"[A-Za-z0-9_-]{1,64}", user) is None or re.fullmatch(r"[A-Za-z0-9_]{10,300}", token) is None:
        raise Refused("credential shape rejected")
    os.makedirs(DOCKER_CONFIG_DIR, mode=0o700, exist_ok=True)
    os.chmod(DOCKER_CONFIG_DIR, 0o700)
    docker("--config", DOCKER_CONFIG_DIR, "login", "ghcr.io", "-u", user, "--password-stdin", stdin_text=token + "\n", timeout=60)
    emit({"ok": True})


def config_args():
    return ["--config", DOCKER_CONFIG_DIR] if os.path.isdir(DOCKER_CONFIG_DIR) else []


def verb_pull(args):
    reference = args[0]
    docker(*(config_args() + ["pull", reference]))
    _, out, _ = docker("image", "inspect", reference)
    info = json.loads(out)[0]
    emit({"ok": True, "imageId": info.get("Id"), "repoDigests": info.get("RepoDigests", [])})


def verb_verify(args):
    digest = args[0]
    image_id = args[1] if len(args) > 1 else None
    code, out, _ = docker("image", "inspect", AGENT_REPO + "@" + digest, check=False)
    if code != 0:
        emit({"ok": False, "error": "image is not present"}, 1)
    info = json.loads(out)[0]
    repo_digests = info.get("RepoDigests", [])
    if AGENT_REPO + "@" + digest not in repo_digests:
        emit({"ok": False, "error": "digest mismatch"}, 1)
    if image_id is not None and info.get("Id") != image_id:
        emit({"ok": False, "error": "image id mismatch"}, 1)
    emit({"ok": True})


def verb_logout(args):
    docker("--config", DOCKER_CONFIG_DIR, "logout", "ghcr.io", check=False)
    shutil.rmtree(DOCKER_CONFIG_DIR, ignore_errors=True)
    emit({"ok": True})


def parse_env_text(text):
    values = {}
    for line in text.split("\n"):
        if not line.strip():
            continue
        if "=" not in line:
            raise Refused("malformed env line")
        key, value = line.split("=", 1)
        if key not in ENV_KEYS:
            raise Refused("env key not allowed: " + key)
        if key in values:
            raise Refused("duplicate env key")
        if ENV_VALUE.fullmatch(value) is None:
            raise Refused("env value not allowed for " + key)
        values[key] = value
    return values


def write_env(values):
    os.makedirs(CONFIG_DIR, mode=0o755, exist_ok=True)
    temporary = ENV_FILE + ".tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w", encoding="ascii") as handle:
        for key in ENV_KEYS:
            if key in values:
                handle.write(key + "=" + values[key] + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, 0o600)
    os.replace(temporary, ENV_FILE)


def read_env():
    with open(ENV_FILE, "r", encoding="ascii") as handle:
        return parse_env_text(handle.read())


def verb_put_env(args):
    values = parse_env_text(read_stdin(4096))
    if "OET_API_BASE" not in values or "OET_NODE_ID" not in values or "OET_NODE_TOKEN" not in values:
        raise Refused("OET_API_BASE, OET_NODE_ID and OET_NODE_TOKEN are required")
    write_env(values)
    emit({"ok": True})


def verb_put_certs(args):
    """Trust plane (decision D3): write the UBAG node certificate material rendered by the manager.

    stdin is one JSON object {"ca","cert","key"} of PEM strings. Every PEM is shape-checked, the leaf is
    verified to have been signed by the CA (openssl), and the files are written atomically into
    /etc/oet-fleet/ubag owned by the agent's numeric uid with mode 0400 (key) / 0444 (certificates).
    """
    payload = json.loads(read_stdin(16384))
    if not isinstance(payload, dict) or set(payload.keys()) != set(CERT_FILES.keys()):
        raise Refused("expected a JSON object with exactly the keys ca, cert, key")
    for name in ("ca", "cert"):
        if not isinstance(payload[name], str) or PEM_CERT.fullmatch(payload[name].strip()) is None:
            raise Refused("the " + name + " PEM is malformed")
    if not isinstance(payload["key"], str) or PEM_KEY.fullmatch(payload["key"].strip()) is None:
        raise Refused("the key PEM is malformed")

    os.makedirs(CERT_DIR, mode=0o755, exist_ok=True)
    temporaries = {}
    for name, filename in CERT_FILES.items():
        temporary = os.path.join(CERT_DIR, "." + filename + ".tmp")
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, "w", encoding="ascii") as handle:
            handle.write(payload[name].strip() + "\n")
        os.chmod(temporary, 0o400)
        os.chown(temporary, AGENT_UID, AGENT_UID)
        temporaries[name] = temporary

    # The leaf must have been signed by this CA and match its key: a mismatched bundle would make the
    # listener present an identity the pin in the allocation list does not describe. openssl is present
    # on every supported OS; both probes run as argument lists, never a shell.
    cert_path = temporaries["cert"]
    ca_path = temporaries["ca"]
    key_path = temporaries["key"]
    probe_env = {"PATH": SAFE_PATH, "LC_ALL": "C.UTF-8"}
    verify = subprocess.run(
        ["/usr/bin/openssl", "verify", "-CAfile", ca_path, cert_path],
        capture_output=True, text=True, env=probe_env, check=False)
    cert_public = subprocess.run(
        ["/usr/bin/openssl", "x509", "-in", cert_path, "-pubkey", "-noout"],
        capture_output=True, text=True, env=probe_env, check=False)
    key_public = subprocess.run(
        ["/usr/bin/openssl", "pkey", "-in", key_path, "-pubout"],
        capture_output=True, text=True, env=probe_env, check=False)
    if verify.returncode != 0 or cert_public.returncode != 0 or key_public.returncode != 0 \
            or cert_public.stdout.strip() != key_public.stdout.strip():
        for temporary in temporaries.values():
            try:
                os.unlink(temporary)
            except OSError:
                pass
        raise Refused("the certificate bundle does not verify against its own CA/key")

    for name, temporary in temporaries.items():
        os.replace(temporary, os.path.join(CERT_DIR, CERT_FILES[name]))
    emit({"ok": True})


def clamp(value, low, high):
    return max(low, min(high, value))


def start_agent(values, digest):
    """(Re)creates THE agent container from the env file, with the fixed hardened flags. Returns the container id.

    The stored budgets are clamped to what this machine can actually give: Docker refuses `--cpus` above the core count,
    so a stored global policy of 3000 millicores on a 2-core helper would otherwise stop the agent from ever starting.
    """
    cores = os.cpu_count() or 1
    total_mib = meminfo("MemTotal") // 1024
    cpu_milli = clamp(int(values.get("OET_BUDGET_CPU_MILLI", "3000")), 500, max(500, cores * 1000))
    mem_cap = max(512, total_mib) if total_mib > 0 else 262144
    mem_mib = clamp(int(values.get("OET_BUDGET_MEM_MIB", "5120")), 512, min(262144, mem_cap))
    tmp_mib = clamp(int(values.get("OET_BUDGET_TMP_MIB", "3072")), 64, mem_mib)
    # Trust plane (decision D3): the manager only ever renders OET_TRUST_ENABLED=true after put-certs, so a
    # missing file here means state drifted (uninstalled by hand, restored from a backup). Refuse loudly
    # instead of silently starting a listener-less "trusted" node.
    trust_args = []
    if values.get("OET_TRUST_ENABLED") == "true":
        missing = [f for f in CERT_FILES.values() if not os.path.isfile(os.path.join(CERT_DIR, f))]
        if missing:
            raise Failed("trust is enabled but the node certificate files are missing: put-certs first")
        trust_args = [
            # The only host mount and the only inbound ports the fleet ever creates; the listener inside
            # presents the node certificate and validates dialers against the manager CA. 443 is published
            # alongside 7443 because UpCloud trial-mode provider firewalls allow only 22/80/443/ICMP and are
            # immutable — the allocation endpoint for such helpers is host:443.
            "--publish", "7443:7443",
            "--publish", "443:7443",
            "--volume", CERT_DIR + ":/certs/ubag:ro",
        ]
    docker("rm", "-f", CONTAINER, check=False)
    _, out, _ = docker(
        "run", "-d",
        "--name", CONTAINER,
        "--init",
        "--read-only",
        "--cap-drop", "ALL",
        "--security-opt", "no-new-privileges",
        "--pids-limit", "512",
        "--memory", "%dm" % mem_mib,
        "--memory-swap", "%dm" % mem_mib,
        "--cpus", "%.2f" % (cpu_milli / 1000.0),
        "--user", "10001:10001",
        "--ulimit", "core=0",
        # tmpfs mounts are root-owned on newer Docker unless uid/mode are given explicitly; the agent (uid 10001)
        # must own its scratch or ScratchManager.WipeAtStart dies with EACCES at every start (seen live on Docker 29.1.3).
        "--tmpfs", "/scratch:rw,noexec,nosuid,nodev,size=%dm,uid=10001,gid=10001,mode=1700" % tmp_mib,
        "--tmpfs", "/tmp:rw,noexec,nosuid,nodev,size=256m,uid=10001,gid=10001,mode=1700",
        *(trust_args),
        "--log-driver", "local",
        "--log-opt", "max-size=5m",
        "--log-opt", "max-file=2",
        "--restart", "unless-stopped",
        "--stop-timeout", "90",
        "--env-file", ENV_FILE,
        # The agent image creates its user with --no-create-home and runs on a read-only root, so HOME must point at the tmpfs
        # (the runtime contract of protocol 10.1). Fixed here, never taken from the env file.
        "--env", "HOME=/tmp",
        "--health-interval", "30s",
        AGENT_REPO + "@" + digest,
    )
    return out.strip()[:64]


def verb_ubag_reconcile(args):
    """One pinned UBAG workload, isolated from the existing OET agent."""
    value = json.loads(read_stdin(8192))
    required = {"digest", "workload_version", "node_id", "primary_uri_san", "address", "primary_address", "primary_public_key", "primary_endpoint", "cpu_millis", "memory_bytes"}
    if set(value) != required:
        raise Refused("invalid UBAG workload fields")
    if not DIGEST.fullmatch(value["digest"]) or not re.fullmatch(r"sha-[a-f0-9]{40}", value["workload_version"]):
        raise Refused("UBAG requires an immutable digest and workload version")
    if not re.fullmatch(r"ubag-[A-Za-z0-9._-]{1,58}", value["node_id"]) or not re.fullmatch(r"spiffe://ubag/primary/[A-Za-z0-9._-]{1,64}", value["primary_uri_san"]):
        raise Refused("invalid UBAG identities")
    for k in ("address", "primary_address"):
        if not ipaddress.IPv4Address(value[k]) in ipaddress.IPv4Network("10.253.240.0/24"):
            raise Refused("UBAG address must be in its private tunnel subnet")
    if value["address"] == value["primary_address"]:
        raise Refused("UBAG peer addresses overlap")
    if not re.fullmatch(r"[A-Za-z0-9+/]{43}=", value["primary_public_key"]) or len(base64.b64decode(value["primary_public_key"], validate=True)) != 32:
        raise Refused("invalid WireGuard public key")
    peer, port = value["primary_endpoint"].rsplit(":", 1)
    ipaddress.IPv4Address(peer)
    if port != "51821": raise Refused("invalid primary WireGuard port")
    cpu, memory = value["cpu_millis"], value["memory_bytes"]
    if type(cpu) is not int or type(memory) is not int or not 1000 <= cpu <= 3000 or not 2684354560 <= memory <= 5368709120:
        raise Refused("UBAG grant cannot hold one bounded browser workload")
    if any(not os.path.isfile(os.path.join(CERT_DIR, f)) for f in CERT_FILES.values()):
        raise Failed("UBAG certificate bundle is not provisioned")
    if shutil.which("wg", path=SAFE_PATH) is None:
        run(["/usr/bin/apt-get", "update", "-qq"])
        run(["/usr/bin/apt-get", "install", "-y", "wireguard-tools"])
    os.makedirs("/etc/wireguard", mode=0o700, exist_ok=True)
    private_path = "/etc/wireguard/ubagwg.key"
    if not os.path.exists(private_path):
        _, private, _ = run(["/usr/bin/wg", "genkey"])
        with open(private_path, "w") as handle: handle.write(private.strip())
        os.chmod(private_path, 0o600)
    with open(private_path) as handle: private = handle.read().strip()
    tunnel = "[Interface]\nAddress = %s/32\nListenPort = 443\nPrivateKey = %s\n[Peer]\nPublicKey = %s\nAllowedIPs = %s/32\nEndpoint = %s\nPersistentKeepalive = 25\n" % (value["address"], private, value["primary_public_key"], value["primary_address"], value["primary_endpoint"])
    wg_path = "/etc/wireguard/ubagwg.conf"
    old = open(wg_path).read() if os.path.exists(wg_path) else ""
    if old != tunnel:
        with open(wg_path, "w") as handle: handle.write(tunnel)
        os.chmod(wg_path, 0o600)
        run(["/usr/bin/systemctl", "enable", "wg-quick@ubagwg"])
        run(["/usr/bin/systemctl", "restart", "wg-quick@ubagwg"])
    else:
        run(["/usr/bin/systemctl", "start", "wg-quick@ubagwg"])
    config_dir = "/etc/oet-fleet/ubag-workload"
    os.makedirs(config_dir, mode=0o700, exist_ok=True)
    config_path = config_dir + "/config.json"
    previous = json.load(open(config_path)) if os.path.exists(config_path) else None
    code, inspect, _ = docker("inspect", "ubag-helper", check=False)
    running = code == 0 and json.loads(inspect)[0]["State"]["Running"]
    if previous != value or not running:
        repo = "ghcr.io/sub-organization-maternal-mind/ubag-helper@" + value["digest"]
        if docker("image", "inspect", repo, check=False)[0] != 0:
            docker("--config", DOCKER_CONFIG_DIR, "pull", repo)
        docker("volume", "create", "ubag-helper-profiles")
        docker("run", "--rm", "--user", "0", "--entrypoint", "/bin/sh", "-v", "ubag-helper-profiles:/profiles", repo, "-c", "chown 10001:10001 /profiles")
        if running:
            docker("stop", "-t", "30", "ubag-helper")
        docker("rm", "ubag-helper", check=False)
        env = {
            "UBAG_HELPER_LISTEN": value["address"] + ":7444", "UBAG_HELPER_NODE_ID": value["node_id"],
            "UBAG_HELPER_CA_FILE": "/etc/ubag-helper/tls/ca.crt", "UBAG_HELPER_TLS_CERT_FILE": "/etc/ubag-helper/tls/node.crt",
            "UBAG_HELPER_TLS_KEY_FILE": "/etc/ubag-helper/tls/node.key", "UBAG_HELPER_PRIMARY_URI_SAN": value["primary_uri_san"],
            "UBAG_HELPER_WORKLOAD_VERSION": value["workload_version"], "UBAG_HELPER_MAX_ATTEMPTS": "1",
            "UBAG_WORKER_STRICT_SUBMIT": "true", "UBAG_WORKER_STAGE_TIMINGS": "true", "DISPLAY": ":99",
        }
        env_args = [arg for k,v in env.items() for arg in ("--env", k+"="+v)]
        docker("run", "-d", "--name", "ubag-helper", "--restart", "unless-stopped", "--init", "--network", "host", "--read-only",
               "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--user", "10001:10001", "--pids-limit", "512",
               "--cpus", str(cpu/1000), "--memory", str(memory), "--memory-swap", str(memory),
               "--volume", CERT_DIR+":/etc/ubag-helper/tls:ro", "--volume", "ubag-helper-profiles:/var/lib/ubag-helper/profiles",
               "--tmpfs", "/tmp:rw,nosuid,nodev,size=1073741824,uid=10001,gid=10001,mode=1777",
               "--tmpfs", "/var/lib/ubag-helper/home:rw,nosuid,nodev,size=67108864,uid=10001,gid=10001,mode=0700",
               *env_args, repo)
        with open(config_path, "w") as handle: json.dump(value, handle)
    _, public, _ = run(["/usr/bin/wg", "pubkey"], stdin_text=private+"\n")
    emit({"ok": True, "wireguardPublicKey": public.strip(), "endpoint": value["address"]+":7444"})


def verb_run(args):
    digest = args[0]
    if not os.path.exists(ENV_FILE):
        raise Failed("no env file; put-env first")
    values = read_env()
    values["OET_AGENT_IMAGE_DIGEST"] = digest
    write_env(values)
    emit({"ok": True, "containerId": start_agent(values, digest)})


def verb_stop(args):
    grace = args[1] if len(args) == 2 else "90"
    docker("stop", "-t", grace, CONTAINER)
    emit({"ok": True})


def verb_restart(args):
    # `docker restart` would keep the environment the container was CREATED with: Docker bakes --env-file in at creation, so a
    # rotated node token written by put-env would never reach the agent and it would fall off the API when the old token's
    # grace period ends (and after every reboot, the boot unit only runs `docker start`). Recreate it from the env file instead.
    if not os.path.exists(ENV_FILE):
        raise Failed("no env file; put-env first")
    values = read_env()
    digest = values.get("OET_AGENT_IMAGE_DIGEST", "")
    if DIGEST.fullmatch(digest) is None:
        raise Failed("the env file names no agent image digest")
    emit({"ok": True, "containerId": start_agent(values, digest)})


def verb_logs(args):
    _, out, err = docker("logs", "--tail", args[1], CONTAINER)
    sys.stdout.write(out + err)
    sys.stdout.flush()
    sys.exit(0)


def list_agent_images():
    code, out, _ = docker("image", "ls", AGENT_REPO, "--no-trunc", "--format", "{{.ID}}", check=False)
    if code != 0:
        return []
    ids = []
    for line in out.split("\n"):
        line = line.strip()
        if DIGEST.fullmatch(line) and line not in ids:
            ids.append(line)
    return ids


def image_created(image_id):
    code, out, _ = docker("image", "inspect", "--format", "{{.Created}}", image_id, check=False)
    return out.strip() if code == 0 else ""


def verb_prune(args):
    running = inspect_agent().get("imageDigest")
    keep_ids = set()
    if running:
        code, out, _ = docker("image", "inspect", "--format", "{{.Id}}", AGENT_REPO + "@" + running, check=False)
        if code == 0:
            keep_ids.add(out.strip())
    candidates = sorted(list_agent_images(), key=image_created, reverse=True)
    kept = 0
    removed = 0
    for image_id in candidates:
        if image_id in keep_ids:
            continue
        if kept < 2:
            kept += 1
            continue
        if docker("image", "rm", image_id, check=False)[0] == 0:
            removed += 1
    emit({"ok": True, "removed": removed})


def verb_wipe_scratch(args):
    # tmpfs mounts live inside the container and start empty on every (re)start.
    docker("restart", CONTAINER)
    emit({"ok": True})


UNIT_TEXT = """[Unit]
Description=OET fleet agent container
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker start oet-fleet-agent
ExecStop=/usr/bin/docker stop -t 90 oet-fleet-agent

[Install]
WantedBy=multi-user.target
"""


def verb_unit_sync(args):
    with open(UNIT_PATH, "w", encoding="ascii") as handle:
        handle.write(UNIT_TEXT)
    os.chmod(UNIT_PATH, 0o644)
    run(["/usr/bin/systemctl", "daemon-reload"], check=False)
    run(["/usr/bin/systemctl", "enable", "oet-fleet-agent.service"], check=False)
    emit({"ok": True})


def verb_uninstall(args):
    warnings = []
    docker("rm", "-f", CONTAINER, check=False)
    for image_id in list_agent_images():
        if docker("image", "rm", "-f", image_id, check=False)[0] != 0:
            warnings.append("an agent image could not be removed")
    run(["/usr/bin/systemctl", "disable", "--now", "oet-fleet-agent.service"], check=False)
    for path in (UNIT_PATH,):
        try:
            os.unlink(path)
        except OSError:
            pass
    run(["/usr/bin/systemctl", "daemon-reload"], check=False)
    shutil.rmtree(CONFIG_DIR, ignore_errors=True)
    shutil.rmtree("/run/oet-fleet", ignore_errors=True)
    # Closing the manager's way in is the LAST thing done, key first and the account lock very last: everything above has
    # already happened by the time a login can fail, so a manager whose connection or process died during this verb can
    # treat "the restricted login is refused" as proof that the uninstall ran (see StepExecutor UninstallAsync).
    for path in ("/home/oetfleet/.ssh/authorized_keys", SUDOERS_PATH, "/usr/local/sbin/oet-fleet-gate"):
        try:
            os.unlink(path)
        except OSError:
            pass
    run(["/usr/sbin/usermod", "-L", "oetfleet"], check=False)
    emit({"ok": True, "warnings": warnings})


HANDLERS = {
    "status": verb_status,
    "harden-check": verb_harden_check,
    "login": verb_login,
    "pull": verb_pull,
    "verify": verb_verify,
    "logout": verb_logout,
    "put-env": verb_put_env,
    "put-certs": verb_put_certs,
    "ubag-reconcile": verb_ubag_reconcile,
    "run": verb_run,
    "stop": verb_stop,
    "restart": verb_restart,
    "logs": verb_logs,
    "prune": verb_prune,
    "wipe-scratch": verb_wipe_scratch,
    "unit-sync": verb_unit_sync,
    "uninstall": verb_uninstall,
}


def main(argv):
    if len(argv) < 2:
        emit({"ok": False, "error": "no verb"}, 2)
    verb = argv[1]
    args = argv[2:]
    try:
        if verb not in VERBS:
            raise Refused("unknown verb")
        if any(argument == "" or re.search(r"\s", argument) for argument in args):
            raise Refused("malformed argument")
        if re.fullmatch(VERBS[verb], " ".join(args)) is None:
            raise Refused("arguments rejected")
        # `stop --grace N` passes the pair through; handlers read the digits from args[1].
        HANDLERS[verb](args)
    except Refused as error:
        emit({"ok": False, "error": str(error)}, 2)
    except Failed as error:
        emit({"ok": False, "error": str(error)}, 1)
    except subprocess.TimeoutExpired:
        emit({"ok": False, "error": "timed out"}, 1)
    except (OSError, ValueError) as error:
        emit({"ok": False, "error": error.__class__.__name__}, 1)


if __name__ == "__main__":
    main(sys.argv)
