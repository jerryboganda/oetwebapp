# ── Auth (Mode A: official Gemini API key from your Google AI Pro account) ──
AGENTGATEWAY_AUTH_MODE=gemini-key
GEMINI_API_KEY=
AGENTGATEWAY_GEMINI_MODEL=gemini-3.7-flash
AGENTGATEWAY_GEMINI_THINKING_LEVEL=MINIMAL

# ── Mode B (opt-in personal Antigravity OAuth session; personal use only) ──
# AGENTGATEWAY_AUTH_MODE=local-oauth
# AGENTGATEWAY_LOCAL_OAUTH_ALLOWED=true
# AGENTGATEWAY_LOCAL_OAUTH_SERVICE=gemini        # Windows Credential Manager
# AGENTGATEWAY_LOCAL_OAUTH_ACCOUNT=antigravity
# AGENTGATEWAY_LOCAL_OAUTH_MODEL=gemini-3.7-flash
# AGENTGATEWAY_LOCAL_OAUTH_BASE_URL=https://daily-cloudcode-pa.googleapis.com/v1internal
# AGENTGATEWAY_LOCAL_OAUTH_TOKEN=                # direct token override (diagnostics only)

# ── Hardening ──────────────────────────────────────────────────────────────
AGENTGATEWAY_BUDGET_TOKENS_PER_DAY=4000000
# AGENTGATEWAY_BUDGET_BY_ROUTE={"writing-examiner":800000,"speaking-interlocutor":600000}
AGENTGATEWAY_CACHE_TTL_SECONDS=3600
AGENTGATEWAY_CACHE_MAX_ENTRIES=512
AGENTGATEWAY_BACKOFF_BASE_SECONDS=1.0
AGENTGATEWAY_BACKOFF_MAX_SECONDS=30.0
AGENTGATEWAY_RETRY_MAX_ATTEMPTS=2

# ── Resilience (v0.2) ──────────────────────────────────────────────────────
# Hard cap on one harness chat() call; the session lock is always released.
AGENTGATEWAY_TURN_TIMEOUT_SECONDS=120
# Circuit breaker per budget route: after N consecutive upstream failures the
# route fast-fails 503 for the cooldown window so the .NET resolver falls back
# to Anthropic/OpenAI-compatible immediately instead of queueing on a dead
# harness/quota.
AGENTGATEWAY_CIRCUIT_FAILURE_THRESHOLD=8
AGENTGATEWAY_CIRCUIT_COOLDOWN_SECONDS=90
# SSE comment ping while a native stream turn is silent (nginx/LB idle safety).
AGENTGATEWAY_SSE_KEEPALIVE_SECONDS=15
# Idle harness sessions are reaped after this TTL (seconds).
AGENTGATEWAY_SESSION_IDLE_TTL_SECONDS=900
# Graceful shutdown: bounded drain window for in-flight turns.
AGENTGATEWAY_DRAIN_TIMEOUT_SECONDS=30
# Request caps (413 beyond these).
AGENTGATEWAY_MAX_MESSAGES_PER_REQUEST=32
AGENTGATEWAY_MAX_PROMPT_CHARS=100000

# ── Observability / performance (v0.2) ─────────────────────────────────────
# Prometheus exposition at GET /v1/metrics (token-guarded).
# Structured JSON logs for Docker log shippers.
AGENTGATEWAY_LOG_JSON=false
# Optional shared response cache for multi-replica deployments. Requires
# pip install 'oet-agent-gateway[redis]'. Falls back to the in-process LRU
# when Redis is unreachable, so a cache outage never takes scoring down.
# AGENTGATEWAY_REDIS_URL=redis://redis:6379/0
# Opt-in SDK-enforced structured outputs per agent (comma list). Empty keeps
# the parity-tested persona JSON contract. Candidates today:
#   writing-examiner,speaking-interlocutor
# AGENTGATEWAY_STRUCTURED_OUTPUT_AGENTS=

# ── Server ─────────────────────────────────────────────────────────────────
AGENTGATEWAY_HOST=0.0.0.0
AGENTGATEWAY_PORT=8305
AGENTGATEWAY_MAX_SESSIONS=16
# Internal auth between the .NET backend and this gateway. Set the same value
# as the AiProvider row's encrypted API key in /admin/ai-providers.
AGENTGATEWAY_INTERNAL_SERVICE_TOKEN=
# AGENTGATEWAY_AGENTS_ENABLED=writing-examiner,speaking-interlocutor,mock-analysis
