# Writing AI sidecars environment (copied to /opt/oetwebapp/.deploy/writing-ai.env on the VPS)
#
# ACCOUNT POOL (owner directive 2026-10-10): one container per subscription account — three Claude Max
# accounts and three ChatGPT Business accounts. All accounts of one engine run the SAME image tag; only
# the credential volume and the per-account caps differ. The writing-ai workflow rewrites the image
# lines on every deploy, so only the caps and the login state need an owner.

# Image tags produced by the writing-ai GitHub Actions workflow (same tag on every account of an engine).
WRITING_CLAUDE_IMAGE=ghcr.io/jerryboganda/oetwebapp-writing-claude:REPLACE_WITH_SHA
WRITING_CODEX_IMAGE=ghcr.io/jerryboganda/oetwebapp-writing-codex:REPLACE_WITH_SHA

# Shared egress allowlist proxy (from the agent-console stack).
WRITING_EGRESS_PROXY=http://oet-agent-egress:3128

# ── Claude Max account 1 (primary; shares the agent-console credential volume) ──
WRITING_CLAUDE_MODEL=claude-opus-5-5
WRITING_CLAUDE_EFFORT=high
# Conservative token budgets used to derive utilisation, per window, until a baseline is known.
# 0 = no cap for that window: the account is never deferred by an estimate (real quota errors still
# park it instantly). Both the rolling 5-hour and the weekly window switch at the same threshold.
WRITING_CLAUDE_5H_TOKEN_CAP=0
WRITING_CLAUDE_WEEKLY_TOKEN_CAP=0

# ── Claude Max accounts 2 and 3 (own credential volume; one-time device-code login each) ──
WRITING_CLAUDE_2_MODEL=claude-opus-5-5
WRITING_CLAUDE_2_EFFORT=high
WRITING_CLAUDE_2_5H_TOKEN_CAP=0
WRITING_CLAUDE_2_WEEKLY_TOKEN_CAP=0
WRITING_CLAUDE_3_MODEL=claude-opus-5-5
WRITING_CLAUDE_3_EFFORT=high
WRITING_CLAUDE_3_5H_TOKEN_CAP=0
WRITING_CLAUDE_3_WEEKLY_TOKEN_CAP=0

# ── ChatGPT Business / Codex account 1 (primary) ──
WRITING_CODEX_MODEL=gpt-6.1-sol
WRITING_CODEX_EFFORT=high
WRITING_CODEX_5H_TOKEN_CAP=0
WRITING_CODEX_WEEKLY_TOKEN_CAP=0

# ── ChatGPT Business / Codex accounts 2 and 3 (own credential volumes) ──
WRITING_CODEX_2_MODEL=gpt-6.1-sol
WRITING_CODEX_2_EFFORT=high
WRITING_CODEX_2_5H_TOKEN_CAP=0
WRITING_CODEX_2_WEEKLY_TOKEN_CAP=0
WRITING_CODEX_3_MODEL=gpt-6.1-sol
WRITING_CODEX_3_EFFORT=high
WRITING_CODEX_3_5H_TOKEN_CAP=0
WRITING_CODEX_3_WEEKLY_TOKEN_CAP=0

# Lane, every sidecar. One CLI run at a time; at most WRITING_QUEUE_MAX requests wait behind it,
# each for at most WRITING_QUEUE_WAIT_MS (the backend's 7-minute attempt budget), else that request
# gets 503 lane_busy. Raise WRITING_LANE_CONCURRENCY only after a burst test shows no login errors.
WRITING_CLI_TIMEOUT_MS=300000
WRITING_QUEUE_MAX=40
WRITING_QUEUE_WAIT_MS=420000
WRITING_LANE_CONCURRENCY=1
