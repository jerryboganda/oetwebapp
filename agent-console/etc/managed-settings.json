{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "forceLoginMethod": "claudeai",
  "cleanupPeriodDays": 90,
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(//opt/oetwebapp/**)",
      "Read(//home/agent/.claude/.credentials.json)",
      "Edit(//home/agent/.claude/.credentials.json)",
      "Read(//home/agent/.codex/auth.json)",
      "Edit(//home/agent/.codex/**)",
      "Read(//home/agent/.config/gh/**)",
      "Edit(//home/agent/.config/gh/**)",
      "Read(//home/agent/.config/oet-agent/**)",
      "Edit(//home/agent/.config/oet-agent/**)",
      "Read(//home/agent/.git-credentials)",
      "Read(//run/**)",
      "Edit(//run/**)",
      "Read(//var/lib/oet-agent/**)",
      "Edit(//var/lib/oet-agent/**)",
      "Edit(//etc/claude-code/**)",
      "Edit(//etc/codex/**)",

      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --force-if-includes *)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push -d *)",
      "Bash(git push --prune *)",
      "Bash(git push --all *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push origin refs/heads/main *)",
      "Bash(git push origin HEAD:refs/heads/main *)",
      "Bash(git push origin +main *)",
      "Bash(git push origin +HEAD:main *)",
      "Bash(git push origin :main *)",
      "Bash(git push -u origin main *)",
      "Bash(git push -u origin HEAD:main *)",
      "Bash(git push -u origin refs/heads/main *)",
      "Bash(git push --set-upstream origin main *)",
      "Bash(git push --set-upstream origin HEAD:main *)",
      "Bash(git push --set-upstream origin refs/heads/main *)",

      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo unarchive *)",
      "Bash(gh repo rename *)",
      "Bash(gh pr merge *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh auth token *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth refresh *)",
      "Bash(gh auth setup-git *)",
      "Bash(gh auth switch *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api -X PATCH *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api --method PATCH *)",
      "Bash(gh api --method PUT *)",

      "Bash(docker volume rm *)",
      "Bash(docker volume remove *)",
      "Bash(docker volume prune *)",
      "Bash(docker system prune *)",
      "Bash(docker container prune *)",
      "Bash(docker image prune *)",
      "Bash(docker network prune *)",
      "Bash(docker builder prune *)",
      "Bash(docker buildx prune *)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)",
      "Bash(docker-compose down -v *)",
      "Bash(docker-compose down --volumes *)",

      "Bash(rm -rf / *)",
      "Bash(rm -rf /opt/oetwebapp *)",
      "Bash(rm -rf /workspace *)",
      "Bash(rm -rf /home/agent *)",
      "Bash(rm -fr / *)",
      "Bash(rm -fr /opt/oetwebapp *)",
      "Bash(rm -fr /workspace *)",
      "Bash(rm -fr /home/agent *)",

      "Bash(claude *)",
      "Bash(codex *)"
    ]
  }
}
