# Production environment template. Copy to .env.production on the VPS and replace placeholders.
# Never commit .env.production. GitHub Actions builds images; the VPS only pulls GHCR images.

APP_URL=https://app.example.com
# Host path for the latest desktop/mobile installers. Only the current version
# per channel is kept; older files are deleted on each native publish.
RELEASES_HOST_PATH=/var/opt/oet-learner/releases
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_API_BASE_URL=https://api.example.com
CHECKOUT_BASE_URL=https://app.example.com/billing
CORS_ALLOWED_ORIGINS=https://app.example.com
API_ALLOWED_HOSTS=api.example.com

NPM_PROXY_NETWORK=npm_proxy
ROUTER_IMAGE=nginx:1.27-alpine
HOST_WEB_PORT=3003
HOST_API_PORT=5001

POSTGRES_DB=oet_learner
POSTGRES_USER=oet_learner
POSTGRES_PASSWORD=replace-with-strong-database-password

AUTH__USEDEVELOPMENTAUTH=false
AUTHTOKENS__ISSUER=https://api.example.com
AUTHTOKENS__AUDIENCE=oet-learner-production
AUTHTOKENS__ACCESSTOKENSIGNINGKEY=replace-with-64-character-random-access-token-key
AUTHTOKENS__REFRESHTOKENSIGNINGKEY=replace-with-64-character-random-refresh-token-key
AUTHTOKENS__ACCESSTOKENLIFETIME=00:15:00
AUTHTOKENS__REFRESHTOKENLIFETIME=30.00:00:00
AUTHTOKENS__OTPLIFETIME=00:10:00
AUTHTOKENS__AUTHENTICATORISSUER=OET Learner

# Firebase Phone Auth is SMS OTP only — not the login authority. Keep disabled
# until Phone Auth, SMS regions, authorized domain, and Blaze billing are ready.
# Email verification always stays on Brevo. Keep BREVO__ENABLED=true as fallback.
FIREBASE__OTP__ENABLED=false
FIREBASE__OTP__SMSENABLED=true
FIREBASE__OTP__EMAILLINKSENABLED=false
FIREBASE__OTP__FALLBACKTOBREVO=true
FIREBASE__OTP__PROJECTID=
FIREBASE__OTP__AUTHDOMAIN=
FIREBASE__OTP__APIKEY=

BREVO__ENABLED=true
BREVO__APIKEY=replace-with-brevo-api-key
BREVO__BASEURL=https://api.brevo.com/v3
BREVO__FROMEMAIL=no-reply@example.com
BREVO__FROMNAME=OET Learner
BREVO__EMAILVERIFICATIONTEMPLATEID=1
BREVO__PASSWORDRESETTEMPLATEID=2
BREVO__WEBHOOKSECRET=replace-with-brevo-webhook-secret
SMTP__ENABLED=true
SMTP__HOST=smtp.example.com
SMTP__PORT=587
SMTP__USERNAME=replace-with-smtp-username
SMTP__PASSWORD=replace-with-smtp-password
SMTP__ENABLESSL=true
SMTP__FROMEMAIL=no-reply@example.com
SMTP__FROMNAME=OET Learner

BILLING__ALLOWSANDBOXFALLBACKS=false
BILLING__STRIPE__SECRETKEY=sk_live_replace-with-stripe-secret
BILLING__STRIPE__SUCCESSURL=https://app.example.com/billing/success
BILLING__STRIPE__CANCELURL=https://app.example.com/billing
BILLING__STRIPE__WEBHOOKSECRET=whsec_replace-with-webhook-secret

NEXT_PUBLIC_SENTRY_DSN=https://replace-with-public-key@o0.ingest.sentry.io/0
SENTRY_DSN=https://replace-with-private-key@o0.ingest.sentry.io/0

AI__BASEURL=https://replace-with-openai-compatible-endpoint/v1
AI__APIKEY=replace-with-ai-provider-key
AI__PROVIDERID=replace-with-provider-id
AI__DEFAULTMODEL=replace-with-model-id
AI__REASONINGEFFORT=
AI__DEFAULTMAXTOKENS=4096
AI__DEFAULTTEMPERATURE=0.2

PRONUNCIATION__PROVIDER=azure
PRONUNCIATION__AZURESPEECHKEY=replace-with-azure-speech-key
PRONUNCIATION__AZURESPEECHREGION=replace-with-azure-region
CONVERSATION__ENABLED=true
CONVERSATION__ASRPROVIDER=deepgram
CONVERSATION__DEEPGRAMAPIKEY=replace-with-deepgram-api-key
CONVERSATION__TTSPROVIDER=elevenlabs
CONVERSATION__ELEVENLABSAPIKEY=replace-with-elevenlabs-api-key
# Real recorded Speaking grading. Prefer the admin `whisper-asr` provider
# registry row, or provide this server-only fallback credential.
SPEAKING__WHISPER__APIKEY=replace-with-openai-whisper-key
SPEAKING__WHISPER__BASEURL=https://api.openai.com/v1
SPEAKING__WHISPER__MODEL=whisper-1
# Optional (the values below are the compose defaults). Speaking grading tries the Claude Max
# subscription sidecar first and falls back to the default Anthropic route. Setting
# SPEAKING_GRADING_PINNED_PROVIDER= (set but empty) turns the pin off. Needs
# OET_INTERNAL_AI_HOSTS to include oet-writing-claude.
SPEAKING_GRADING_PINNED_PROVIDER=writing-claude-sub
SPEAKING_GRADING_PINNED_MODEL=claude-opus-5-5

UPLOAD_SCANNER__PROVIDER=clamav
UPLOAD_SCANNER__HOST=clamav
UPLOAD_SCANNER__PORT=3310
UPLOAD_SCANNER__FAILCLOSEDONERROR=true
PASSWORDPOLICY__BREACHCHECKENABLED=true

BACKUP_SCHEDULE=17 2 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_PASSPHRASE=replace-with-strong-backup-passphrase
BACKUP_S3_URL=s3://replace-with-offsite-backup-bucket/oet-prod
BACKUP_S3_EXTRA_ARGS=--endpoint-url https://replace-with-s3-compatible-endpoint
BACKUP_ALERT_WEBHOOK=https://replace-with-alert-host.example.com/backup-alert
BACKUP_AWS_ACCESS_KEY_ID=replace-with-backup-access-key
BACKUP_AWS_SECRET_ACCESS_KEY=replace-with-backup-secret-key
BACKUP_AWS_REGION=auto
BACKUP_RESTORE_DRILL_ID=replace-with-latest-restore-drill-id

# Platform media storage. Use the same bucket or grant read access to the
# LiveKit egress bucket so completed tutor recordings become playable.
STORAGE__PROVIDER=s3
STORAGE__BUCKETNAME=replace-with-speaking-recordings
STORAGE__ACCESSKEYID=replace-with-storage-access-key
STORAGE__SECRETACCESSKEY=replace-with-storage-secret-key
STORAGE__AWSREGION=replace-with-bucket-region
STORAGE__ENDPOINTURL=

READING_SMOKE_LEARNER_EMAIL=replace-with-reading-smoke-learner-email
READING_SMOKE_LEARNER_PASSWORD=replace-with-reading-smoke-learner-password
READING_SMOKE_DISABLED_PAPER_ID=replace-with-disabled-paper-id
READING_SMOKE_ENABLED_PAPER_ID=replace-with-enabled-paper-id
READING_SMOKE_PROTECTED_MEDIA_ID=replace-with-protected-media-id
READING_SMOKE_ENTITLED_MEDIA_ID=replace-with-entitled-media-id

FALLBACK_EMAIL_DOMAIN=example.com
MAX_UPLOAD_BYTES=1073741824
AUTO_MIGRATE=false
SEED_DEMO_DATA=false
ENABLE_SWAGGER=false
# Optional: true makes /health/ready require verified live voice + LiveKit recording.
FEATURES__SPEAKINGV2=false
GEMINI_API_KEY=replace-with-gemini-api-key
# OPTIONAL (2026-09-23): live voice, LiveKit and TypeSafe may all be left blank.
# Without a live voice key every Speaking mode records and is graded by STT;
# without LiveKit, tutor booking shows a controlled unavailable state.
# Native live Speaking voice providers. Keys stay server-side and are never
# exposed to the browser. The OpenAI model is probed before release; keep the
# configured model at the lowest-latency production model enabled on the account.
LIVEVOICE__PRIMARYPROVIDER=openai
LIVEVOICE__OPENAIAPIKEY=replace-with-openai-live-voice-key
LIVEVOICE__OPENAIBASEURL=https://api.openai.com/v1/live/sessions
LIVEVOICE__OPENAIMODELSBASEURL=https://api.openai.com/v1/models
LIVEVOICE__OPENAIMODEL=gpt-live-1
LIVEVOICE__GEMINIAPIKEY=replace-with-gemini-live-api-key
LIVEVOICE__GEMINIBASEURL=https://generativelanguage.googleapis.com/v1beta/auth_tokens
LIVEVOICE__GEMINIMODELSBASEURL=https://generativelanguage.googleapis.com/v1beta/models
LIVEVOICE__GEMINIMODEL=models/gemini-3.8-live
LIVEVOICE__GEMINIWEBSOCKETBASEURL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContentConstrained
LIVEVOICE__RETENTIONDAYS=30
# Human tutor rooms. Production must use the real gateway, never the dev stub.
LIVEKIT__PROVIDER=livekit_cloud
LIVEKIT__APIKEY=replace-with-livekit-api-key
LIVEKIT__APISECRET=replace-with-livekit-api-secret
LIVEKIT__WSSURL=wss://replace-with-livekit-host
LIVEKIT__WEBHOOKSIGNINGSECRET=replace-with-livekit-webhook-secret
LIVEKIT__DEFAULTMAXDURATIONSECONDS=1800
LIVEKIT__EGRESSENABLED=true
LIVEKIT__EGRESSBUCKET=s3://replace-with-speaking-recordings
LIVEKIT__EGRESSBUCKETREGION=replace-with-bucket-region
LIVEKIT__EGRESSACCESSKEY=replace-with-egress-s3-access-key
LIVEKIT__EGRESSSECRET=replace-with-egress-s3-secret
# Optional for S3-compatible providers such as R2 or DigitalOcean Spaces.
LIVEKIT__EGRESSENDPOINT=
LIVEKIT__EGRESSFORCEPATHSTYLE=false
# TypeSafe SystemOne (server-side only — paste the live key into .env.production on the VPS).
TYPESAFE_API_KEY=replace-with-typesafe-api-key
# .NET backend direct jev judgment calls. Paste the same live key below and
# Keep the master switch and live-voice advisory surface enabled in production.
# The server still fail-closes the integration when the key is absent or invalid.
TYPESAFE__ENABLED=true
TYPESAFE__APIKEY=replace-with-typesafe-api-key
TYPESAFE__CONVERSATIONADVISORYENABLED=true

# Owner Agent Console (owner-only; agent-console/CONTRACT.md). OPTIONAL: keep
# OWNER_AGENT__ENABLED=false until the oet-agent-console stack is deployed by
# .github/workflows/agent-console.yml. When true, validate-production-env.sh
# requires every secret below. Generate them as HEX only (hex can never trip
# the placeholder / mock-stub scans and is URL-safe):
#   tokens:      openssl rand -hex 32     (64 chars; the two tokens must differ)
#   DB password: openssl rand -hex 24     (48 chars; then run
#                scripts/ops/create-owner-agent-db-role.sql to create/rotate the role)
# OWNER_AGENT__OWNERACCOUNTIDS: comma-separated auth account ids (auth_...) of
# the owner only. OWNER_AGENT__BASEURL defaults to http://oet-agent-console:8410.
OWNER_AGENT__ENABLED=false
OWNER_AGENT__INTERNALTOKEN=
OWNER_AGENT__PROXYTOKEN=
OWNER_AGENT__DBPASSWORD=
OWNER_AGENT__OWNERACCOUNTIDS=
OWNER_AGENT__CODEXWORKSPACEID=
