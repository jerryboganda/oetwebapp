<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied to the macOS app bundle by tauri-bundler (bundle.macOS.entitlements).
  Keep this list minimal: an entitlement that is not strictly required is a
  security regression, and these only take effect once the build is signed with
  the hardened runtime enabled.

  Removed: com.apple.security.cs.allow-unsigned-executable-memory (the legacy,
  broader allowance that com.apple.security.cs.allow-jit supersedes for modern
  MAP_JIT based JavaScript engines) and com.apple.security.inherit (only
  meaningful for child processes, and it was set to false).
-->
<plist version="1.0">
<dict>
	<!-- Speaking-exam recording inside WKWebView. Paired with
	     NSMicrophoneUsageDescription in Info.plist, which drives the TCC
	     consent prompt — the entitlement alone is not sufficient. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- JavaScript inside the bundled splash and the remote page runs on JIT.
	     Under the hardened runtime this allowance is what permits it. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
