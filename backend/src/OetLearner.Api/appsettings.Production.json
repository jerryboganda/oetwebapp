{
  "AuthTokens": {
    "Issuer": "https://api.example.com",
    "Audience": "oet-learner-web",
    "AccessTokenSigningKey": "",
    "RefreshTokenSigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "OtpLifetime": "00:10:00",
    "AuthenticatorIssuer": "OET Learner"
  },
  "Bootstrap": {
    "AutoMigrate": false,
    "SeedDemoData": false
  },
  "Proxy": {
    "TrustForwardHeaders": true,
    "EnforceHttps": true,
    "KnownNetworks": [ "127.0.0.1/8", "::1/128", "172.16.0.0/12", "10.0.0.0/8" ]
  },
  "Features": {
    "EnableSwagger": false,
    "ListeningExpertOverride": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
