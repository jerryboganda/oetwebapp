# Repository-root context for the web image only.
**
!app/
!app/**
!pages/
!pages/**
!components/
!components/**
!contexts/
!contexts/**
!hooks/
!hooks/**
!lib/
!lib/**
!public/
!public/**
!messages/
!messages/**
!types/
!types/**
!data/
!data/**
!rulebooks/
!rulebooks/**

# Build configuration and runtime entrypoints.
!package.json
!pnpm-lock.yaml
!.npmrc
!tsconfig.json
!next-env.d.ts
!next.config.ts
!postcss.config.mjs
!i18n.ts
!proxy.ts
!middleware.ts
!instrumentation.ts
!instrumentation-client.ts
!sentry.client.config.ts
!sentry.server.config.ts
!sentry.edge.config.ts

# Exclude secrets and local/generated files even inside retained trees.
**/.env*
**/.git
**/node_modules
**/.next
**/.cache
**/*.log
**/*.tsbuildinfo
**/*.test.*
**/*.spec.*
**/__tests__
