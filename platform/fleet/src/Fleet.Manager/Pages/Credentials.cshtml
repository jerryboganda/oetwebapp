@page
@model CredentialsModel
@{
    ViewData["Title"] = "Credentials";
    var data = Model.Data;
}
<div class="page-head">
    <h1>Credentials</h1>
</div>
@await Html.PartialAsync("_Messages", Model)
<p class="muted">Write-only: a secret goes in once and is never shown again. This page lists what is stored by its fingerprint hint (the first 8 hex characters of a hash) and its dates, and lets you add, replace, rotate and revoke.</p>

<section class="panel" aria-labelledby="own-h">
    <h2 id="own-h">Temporary owner SSH keys</h2>
    <p class="muted">The key you give for preparing or repairing a helper. Encrypted at once, erased when the preparation ends, when you cancel, or after 60 minutes.</p>
    @if (data.OwnerKeys.Count == 0)
    {
        <p class="empty">No temporary key is stored. That is the normal state.</p>
    }
    else
    {
        <div class="table-wrap" role="region" aria-label="Stored owner keys" tabindex="0">
            <table class="data compact">
                <caption class="sr-only">Temporary owner SSH keys that are stored right now</caption>
                <thead>
                <tr>
                    <th scope="col">Helper</th>
                    <th scope="col">Fingerprint</th>
                    <th scope="col">Stored</th>
                    <th scope="col">Erased</th>
                    <th scope="col">Revoke</th>
                </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < data.OwnerKeys.Count; i++)
                {
                    var key = data.OwnerKeys[i];
                    <tr>
                        <th scope="row"><a href="@("/Hosts/Detail/" + Uri.EscapeDataString(key.HostId))">@key.HostName</a></th>
                        <td><code>@key.Hint</code></td>
                        <td>@Fmt.Ago(key.CreatedAt, data.Now)</td>
                        <td>@Fmt.Until(key.ExpiresAt, data.Now)</td>
                        <td>
                            <form method="post" action="/Credentials?handler=RevokeKey" asp-antiforgery="true" class="code-form" autocomplete="off">
                                <input type="hidden" name="hostId" value="@key.HostId" />
                                @await Html.PartialAsync("_StepUpInline", "revoke-" + i)
                                <button type="submit" class="btn danger">Erase now</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel" aria-labelledby="add-h">
    <h2 id="add-h">Add or replace a temporary key</h2>
    @if (data.AwaitingKey.Count == 0)
    {
        <p class="empty">No enrollment or repair can take a key right now. Add a helper, or start a repair from a helper's page; it then appears here.</p>
    }
    else
    {
        <form method="post" action="/Credentials?handler=AddKey" asp-antiforgery="true" autocomplete="off">
            <div class="field">
                <label for="OperationId">For which operation</label>
                <select id="OperationId" name="OperationId" required>
                    @foreach (var waiting in data.AwaitingKey)
                    {
                        <option value="@waiting.Id">@(Fmt.KindLabel(waiting.Kind) + " of " + waiting.HostName + " (" + Fmt.StateLabel(waiting.State) + ")")</option>
                    }
                </select>
            </div>
            @await Html.PartialAsync("_KeyFields", new KeyFieldsModel("cred", Model.SshUser))
            @await Html.PartialAsync("_StepUp", "addkey")
            <div class="actions">
                <button type="submit" class="btn primary">Store the key</button>
            </div>
        </form>
    }
</section>

<section class="panel" aria-labelledby="tok-h">
    <h2 id="tok-h">Node tokens</h2>
    <p class="muted">Each agent signs in to the OET API with its own token. The console issues it, writes it to the helper and keeps no copy: only the fingerprint of the last one it installed. Tokens last 30 days and are rotated automatically after 14.</p>
    @if (data.NodeTokens.Count == 0)
    {
        <p class="empty">No helper has a node token yet.</p>
    }
    else
    {
        <div class="table-wrap" role="region" aria-label="Node tokens" tabindex="0">
            <table class="data compact">
                <caption class="sr-only">Node tokens per helper</caption>
                <thead>
                <tr>
                    <th scope="col">Helper</th>
                    <th scope="col">Last installed</th>
                    <th scope="col">Active tokens</th>
                    <th scope="col">Next expiry</th>
                    <th scope="col">Rotate</th>
                </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < data.NodeTokens.Count; i++)
                {
                    var token = data.NodeTokens[i];
                    <tr>
                        <th scope="row"><a href="@("/Hosts/Detail/" + Uri.EscapeDataString(token.HostId))">@token.HostName</a></th>
                        <td>
                            @if (token.Hint is null)
                            {
                                <span class="muted">&mdash;</span>
                            }
                            else
                            {
                                <code>@token.Hint</code>
                                <span class="sub">@Fmt.Ago(token.RenderedAt, data.Now)</span>
                            }
                        </td>
                        <td>@(token.ActiveTokens?.ToString() ?? "—")</td>
                        <td>@Fmt.Until(token.NextExpiryAt, data.Now)</td>
                        <td>
                            @if (token.CanRotate)
                            {
                                <form method="post" action="/Credentials?handler=RotateToken" asp-antiforgery="true" class="code-form" autocomplete="off">
                                    <input type="hidden" name="hostId" value="@token.HostId" />
                                    @await Html.PartialAsync("_StepUpInline", "rotate-" + i)
                                    <button type="submit" class="btn">Rotate</button>
                                </form>
                            }
                            else
                            {
                                <span class="muted">not available</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel" aria-labelledby="mgr-h">
    <h2 id="mgr-h">Manager SSH keys</h2>
    <p class="muted">One restricted key per helper, generated by the manager and kept encrypted in the vault. It can only run the fixed set of fleet commands on the helper. It is created at enrollment and revoked when the helper is removed; to get a new one, remove the helper and add it again.</p>
    @if (data.ManagerKeys.Count == 0)
    {
        <p class="empty">No manager key is stored.</p>
    }
    else
    {
        <div class="table-wrap" role="region" aria-label="Manager keys" tabindex="0">
            <table class="data compact">
                <caption class="sr-only">Manager SSH keys per helper</caption>
                <thead>
                <tr>
                    <th scope="col">Helper</th>
                    <th scope="col">Fingerprint</th>
                    <th scope="col">Created</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var key in data.ManagerKeys)
                {
                    <tr>
                        <th scope="row"><a href="@("/Hosts/Detail/" + Uri.EscapeDataString(key.HostId))">@key.HostName</a></th>
                        <td><code>@key.Hint</code></td>
                        <td>@Fmt.Ago(key.CreatedAt, data.Now)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel" aria-labelledby="svc-h">
    <h2 id="svc-h">Service secrets and the registry token</h2>
    <dl class="kv">
        @foreach (var line in data.Services)
        {
            <dt>@line.Name</dt>
            <dd>
                <span class="badge @(line.Present ? "ok" : "muted")">@(line.Present ? "present" : "absent")</span>
                <span class="sub">@line.Detail</span>
            </dd>
        }
        <dt>Vault master key</dt>
        <dd>
            <code>@data.MasterKeyId</code>
            <span class="badge @(data.PreviousKeyLoaded ? "warn" : "ok")">@(data.PreviousKeyLoaded ? "a previous key is also loaded (rotation in progress)" : "single key")</span>
            <span class="sub">Rotate it from the server: put the new key in the secret file and the old one beside it, run <code>vault-rewrap</code>, then remove the old file.</span>
        </dd>
        <dt>Registry pull token</dt>
        <dd>
            <span class="badge @(data.PullTokenHeld ? "ok" : "muted")">@(data.PullTokenHeld ? "held in memory" : "not held")</span>
            <span class="sub">supplied by the CI sync job for one rollout, one hour at most, never written to disk</span>
        </dd>
    </dl>
    @if (data.PullTokenHeld)
    {
        <form method="post" action="/Credentials?handler=DiscardPullToken" asp-antiforgery="true" class="code-form" autocomplete="off">
            @await Html.PartialAsync("_StepUpInline", "discard")
            <button type="submit" class="btn danger">Discard the pull token</button>
        </form>
    }
</section>
