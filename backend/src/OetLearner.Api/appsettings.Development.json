{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=oet_learner_dev;Username=postgres;Password=postgres"
  },
  "Auth": {
    "UseDevelopmentAuth": true
  },
  "AuthTokens": {
    "Issuer": "https://api.local.oetlearner.test",
    "Audience": "oet-learner-web",
    "AccessTokenSigningKey": "dev-access-token-signing-key-1234567890",
    "RefreshTokenSigningKey": "dev-refresh-token-signing-key-1234567890",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "OtpLifetime": "00:10:00",
    "AuthenticatorIssuer": "OET Learner (Dev)"
  },
  "Bootstrap": {
    "AutoMigrate": true,
    "SeedDemoData": false
  },
  "Platform": {
    "PublicApiBaseUrl": "http://localhost:5198",
    "PublicWebBaseUrl": "http://localhost:3000",
    "FallbackEmailDomain": "example.test"
  },
  "ExternalAuth": {
    "Google": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": ""
    },
    "LinkedIn": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Billing": {
    "CheckoutBaseUrl": "http://localhost:3000/billing/checkout",
    "AllowSandboxFallbacks": true
  },
  "Proxy": {
    "TrustForwardHeaders": false,
    "EnforceHttps": false
  },
  "Features": {
    "EnableSwagger": true,
    "ListeningExpertOverride": true
  },
  "MockSampleSeeder": {
    "Enabled": true,
    "SourceRootPath": "../../../Project Real Content"
  },
  "Content": {
    "Oet2026Catalog": {
      "Enabled": true,
      "CreateContentPackages": true
    }
  },
  "LiveKit": {
    "Provider": "disabled",
    "ApiKey": "",
    "ApiSecret": "",
    "WssUrl": "wss://example.livekit.cloud",
    "WebhookSigningSecret": "",
    "DefaultMaxDurationSeconds": 1800,
    "EgressEnabled": true,
    "EgressBucket": ""
  },
  "LiveVoice": {
    "PrimaryProvider": "openai",
    "OpenAiBaseUrl": "https://api.openai.com/v1/live/sessions",
    "OpenAiModelsBaseUrl": "https://api.openai.com/v1/models",
    "OpenAiModel": "gpt-live-1",
    "GeminiBaseUrl": "https://generativelanguage.googleapis.com/v1beta/auth_tokens",
    "GeminiModelsBaseUrl": "https://generativelanguage.googleapis.com/v1beta/models",
    "GeminiWebSocketBaseUrl": "wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContentConstrained",
    "GeminiModel": "models/gemini-3.8-live",
    "RetentionDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
