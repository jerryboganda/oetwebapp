<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    OET fleet helper agent (OET-RWP/1). Stateless executor: claims fenced jobs from the OET API over HTTPS,
    runs them in isolated child processes and reports results. No database, storage, AI-provider or
    docker-socket access exists in this project by construction (protocol section 1.3, H5/H6).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Fleet.Agent</AssemblyName>
    <RootNamespace>Fleet.Agent</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UseAppHost>false</UseAppHost>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Same ICU/culture behaviour as the API image (protocol 6.1.4 item 4): never set invariant globalization. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fleet.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <!-- MUST equal the version in backend/src/OetLearner.Api/OetLearner.Api.csproj (protocol RW-101, asserted by a CI test). -->
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <!--
    LINK-COMPILED, never copied (protocol 6.1.4): the exact in-process extractor source is compiled into the agent so
    the helper output is byte-identical to PdfPigPdfTextExtractor. Files the API track adds later are picked up
    automatically when they exist; the matching executor is advertised only when its source is present.
  -->
  <PropertyGroup>
    <FleetRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', '..'))</FleetRepoRoot>
    <FleetApiServicesDir>$(FleetRepoRoot)backend/src/OetLearner.Api/Services/</FleetApiServicesDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Fallback/**" />
    <Compile Include="$(FleetApiServicesDir)Content/PdfPigPdfTextExtractor.cs" Link="Linked/PdfPigPdfTextExtractor.cs" />
  </ItemGroup>

  <!-- PdfTextEngine.LayoutRevision: shared constant file owned by the API track (protocol 6.1.4 item 3). -->
  <ItemGroup Condition="Exists('$(FleetApiServicesDir)Content/PdfTextEngine.cs')">
    <Compile Include="$(FleetApiServicesDir)Content/PdfTextEngine.cs" Link="Linked/PdfTextEngine.cs" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(FleetApiServicesDir)Content/PdfTextEngine.cs')">
    <Compile Include="Fallback/PdfTextEngine.fallback.cs" />
  </ItemGroup>

  <!-- companion.index-prep needs the pure CompanionChunker extracted by the API track (protocol 6.2). -->
  <ItemGroup Condition="Exists('$(FleetApiServicesDir)Companion/CompanionChunker.cs')">
    <Compile Include="$(FleetApiServicesDir)Companion/CompanionChunker.cs" Link="Linked/CompanionChunker.cs" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(FleetApiServicesDir)Companion/CompanionChunker.cs')">
    <DefineConstants>$(DefineConstants);FLEET_HAS_COMPANION_CHUNKER</DefineConstants>
  </PropertyGroup>

  <!-- media.speaking-join needs PcmJoiner moved to its own pure file by the API track (protocol 6.4). -->
  <ItemGroup Condition="Exists('$(FleetApiServicesDir)Speaking/PcmJoiner.cs')">
    <Compile Include="$(FleetApiServicesDir)Speaking/PcmJoiner.cs" Link="Linked/PcmJoiner.cs" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(FleetApiServicesDir)Speaking/PcmJoiner.cs')">
    <DefineConstants>$(DefineConstants);FLEET_HAS_PCM_JOINER</DefineConstants>
  </PropertyGroup>

</Project>
