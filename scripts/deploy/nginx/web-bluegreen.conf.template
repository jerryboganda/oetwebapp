map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $public_forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

# Force download for installers — critical for Safari on .dmg (otherwise it
# renders the binary as text). Nginx serves /releases/ directly (sendfile)
# so the Next.js route's headers are bypassed; this map restores them here.
map $request_uri $release_disposition {
    default "attachment";
    "~*\.dmg(\?|$)"  "attachment; filename=\"OET.with.Dr.Hesham.dmg\"; filename*=UTF-8''OET.with.Dr.Hesham.dmg";
    "~*\.ipa(\?|$)"  "attachment; filename=\"OET.with.Dr.Hesham.ipa\"; filename*=UTF-8''OET.with.Dr.Hesham.ipa";
    "~*\.apk(\?|$)"  "attachment; filename=\"OET.with.Dr.Hesham.apk\"; filename*=UTF-8''OET.with.Dr.Hesham.apk";
    "~*\.exe(\?|$)"  "attachment; filename=\"OET.with.Dr.Hesham.exe\"; filename*=UTF-8''OET.with.Dr.Hesham.exe";
}

server {
    listen 3000;
    server_name _;

    # Allow large admin asset uploads (chunked, 8 MB/part; full audio up to ~150 MB).
    client_max_body_size 200m;

    # Immutable versioned installers. Manifests are short-cached below.
    location ~* ^/releases/.+/current\.json$ {
        root /var/opt/oet-learner;
        default_type application/json;
        add_header Cache-Control "public, max-age=30, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location /releases/ {
        alias /var/opt/oet-learner/releases/;
        autoindex off;
        sendfile on;
        tcp_nopush on;
        gzip off;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Content-Disposition $release_disposition always;
        types {
            application/json json;
            text/plain txt;
            application/x-apple-diskimage dmg;
            application/vnd.microsoft.portable-executable exe;
            application/vnd.android.package-archive apk;
            application/octet-stream aab ipa sig;
            application/gzip gz;
        }
        default_type application/octet-stream;
    }

    location = /desktop/updates/latest.json {
        alias /var/opt/oet-learner/releases/desktop/current.json;
        default_type application/json;
        add_header Cache-Control "public, max-age=30, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Direct server-to-server payment webhook pass-through to the API container.
    # Gateway webhooks (Whop, Stripe, PayPal, Fawaterak, etc.) targeting the web host
    # bypass Next.js middleware and route directly to ASP.NET Core without redirects.
    location ^~ /v1/payment/webhooks/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $api_upstream http://learner-api-${ACTIVE_SLOT}:8080;

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $public_forwarded_proto;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $web_upstream http://web-${ACTIVE_SLOT}:3000;

        proxy_pass $web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $public_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
