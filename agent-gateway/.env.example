# ── Auth (Mode A: official Gemini API key from your Google AI Pro account) ──
AGENTGATEWAY_AUTH_MODE=gemini-key
GEMINI_API_KEY=
AGENTGATEWAY_GEMINI_MODEL=gemini-3-flash
AGENTGATEWAY_GEMINI_THINKING_LEVEL=MINIMAL

# ── Mode B (opt-in personal Antigravity OAuth session; personal use only) ──
# AGENTGATEWAY_AUTH_MODE=local-oauth
# AGENTGATEWAY_LOCAL_OAUTH_ALLOWED=true
# AGENTGATEWAY_LOCAL_OAUTH_SERVICE=gemini        # Windows Credential Manager
# AGENTGATEWAY_LOCAL_OAUTH_ACCOUNT=antigravity
# AGENTGATEWAY_LOCAL_OAUTH_MODEL=gemini-3-flash
# AGENTGATEWAY_LOCAL_OAUTH_BASE_URL=https://daily-cloudcode-pa.googleapis.com/v1internal
# AGENTGATEWAY_LOCAL_OAUTH_TOKEN=                # direct token override (diagnostics only)

# ── Hardening ──────────────────────────────────────────────────────────────
AGENTGATEWAY_BUDGET_TOKENS_PER_DAY=4000000
# AGENTGATEWAY_BUDGET_BY_ROUTE={"writing-examiner":800000,"speaking-interlocutor":600000}
AGENTGATEWAY_CACHE_TTL_SECONDS=3600
AGENTGATEWAY_CACHE_MAX_ENTRIES=512
AGENTGATEWAY_BACKOFF_BASE_SECONDS=1.0
AGENTGATEWAY_BACKOFF_MAX_SECONDS=30.0
AGENTGATEWAY_RETRY_MAX_ATTEMPTS=2

# ── Server ─────────────────────────────────────────────────────────────────
AGENTGATEWAY_HOST=0.0.0.0
AGENTGATEWAY_PORT=8305
AGENTGATEWAY_MAX_SESSIONS=16
# Internal auth between the .NET backend and this gateway. Set the same value
# as the AiProvider row's encrypted API key in /admin/ai-providers.
AGENTGATEWAY_INTERNAL_SERVICE_TOKEN=
# AGENTGATEWAY_AGENTS_ENABLED=writing-examiner,speaking-interlocutor,mock-analysis
