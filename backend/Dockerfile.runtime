# syntax=docker/dockerfile:1.19
FROM mcr.microsoft.com/dotnet/aspnet:10.0

# - curl: required for the container HEALTHCHECK
# - tesseract-ocr / tesseract-ocr-eng: native binaries + English trained data
#   for the Tesseract wrapper used by WritingOcrService.
# - libleptonica-dev: provides libleptonica used by libtesseract.
# - ffmpeg: decodes the candidate's stored Speaking clips (webm/opus, mp4/aac) and encodes the one mp3 the
#   OpenAI audio judge accepts (SpeakingAudioEvidenceService). Used through stdin/stdout only: no audio is
#   ever written to the container's disk.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        tesseract-ocr \
        tesseract-ocr-eng \
        libleptonica-dev \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN groupadd --gid 10001 appgroup \
    && useradd --uid 10001 --gid appgroup --create-home --home-dir /home/appuser appuser \
    && mkdir -p /var/opt/oet-learner/storage \
    && chown -R appuser:appgroup /app /var/opt/oet-learner /home/appuser

# The publish directory is produced and checked by the preceding Actions-host
# step. The VPS never receives source code or performs a source build.
# Keep unchanged dependency/content bytes out of each new application layer.
COPY --exclude=OetLearner.Api.* backend/publish ./
RUN test ! -e /app/OetLearner.Api.dll
COPY backend/publish/OetLearner.Api.* ./
RUN --mount=type=bind,source=backend/publish,target=/published \
    cd /published \
    && find . -type f -exec sha256sum {} + > /tmp/published.sha256 \
    && cd /app \
    && sha256sum --check --quiet /tmp/published.sha256 \
    && rm /tmp/published.sha256

ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
  CMD curl --fail http://127.0.0.1:8080/health/ready || exit 1

USER appuser

ENTRYPOINT ["dotnet", "OetLearner.Api.dll"]
