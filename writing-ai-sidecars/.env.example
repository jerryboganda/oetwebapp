# Writing AI sidecars environment (copied to /opt/oetwebapp/.deploy/writing-ai.env on the VPS)

# Image tags produced by the writing-ai GitHub Actions workflow.
WRITING_CLAUDE_IMAGE=ghcr.io/jerryboganda/oetwebapp-writing-claude:REPLACE_WITH_SHA
WRITING_CODEX_IMAGE=ghcr.io/jerryboganda/oetwebapp-writing-codex:REPLACE_WITH_SHA

# Shared egress allowlist proxy (from the agent-console stack).
WRITING_EGRESS_PROXY=http://oet-agent-egress:3128

# Primary — dedicated Claude Max 5x subscription.
WRITING_CLAUDE_MODEL=claude-opus-5-5
WRITING_CLAUDE_EFFORT=high
# Conservative weekly token budget used to derive utilisation until a baseline
# is known. 0 = no cap (backend falls back to its own AiUsageRecord estimate).
WRITING_CLAUDE_WEEKLY_TOKEN_CAP=0

# Fallback — Codex / ChatGPT subscription (owner 2026-10-02: GPT-6.1 Sol High).
WRITING_CODEX_MODEL=gpt-6.1-sol
WRITING_CODEX_EFFORT=high
WRITING_CODEX_WEEKLY_TOKEN_CAP=0

# Lane, both sidecars. One CLI run at a time; at most WRITING_QUEUE_MAX requests wait behind it,
# each for at most WRITING_QUEUE_WAIT_MS (the backend's 7-minute attempt budget), else that request
# gets 503 lane_busy. Raise WRITING_LANE_CONCURRENCY only after a burst test shows no login errors.
WRITING_CLI_TIMEOUT_MS=300000
WRITING_QUEUE_MAX=40
WRITING_QUEUE_WAIT_MS=420000
WRITING_LANE_CONCURRENCY=1
