@page
@model LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Fleet sign-in</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
<main class="card">
    <h1>OET Fleet Manager</h1>
    <p class="muted">Owner sign-in. This console is reachable only through the SSH tunnel.</p>
    @if (Model.Error is not null)
    {
        <p class="error" role="alert">@Model.Error</p>
    }
    <form method="post" autocomplete="off" asp-antiforgery="true">
        <label for="Password">Password</label>
        <input id="Password" name="Password" type="password" autocomplete="off" required />
        <label for="Code">Authenticator code</label>
        <input id="Code" name="Code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="off" required />
        <button type="submit">Sign in</button>
    </form>
</main>
</body>
</html>
