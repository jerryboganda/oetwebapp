    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "node-pty": "1.1.0",
    "pino": "10.3.1",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
